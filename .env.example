# Supabase project. Use a development project locally and in Vercel previews when possible.
# The anon/publishable key is public; never put a service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Public PostHog project token. Find it in PostHog: Project settings > Project API key.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token

# Use https://us.i.posthog.com for US Cloud or https://eu.i.posthog.com for EU Cloud.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Analytics 4 measurement ID. It starts with "G-" and is safe to expose in the browser.
# Leave it unset to disable Google Analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Canonical public URL used for SEO metadata. Defaults to https://mis-finanzas-black.vercel.app.
# NEXT_PUBLIC_SITE_URL=https://jirehfinanzas.com
