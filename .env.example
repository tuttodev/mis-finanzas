# Public PostHog project token. Find it in PostHog: Project settings > Project API key.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token

# Use https://us.i.posthog.com for US Cloud or https://eu.i.posthog.com for EU Cloud.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Analytics 4 measurement ID. It starts with "G-" and is safe to expose in the browser.
# Leave it unset to disable Google Analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
